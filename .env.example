# Valores de referencia: exportar en la terminal o pasar con docker --env-file.
# Python no carga este archivo automáticamente.
HOST=127.0.0.1
PORT=8000
DB_PATH=data/cuenta.db
ADMIN_USER=admin
# Reemplaza este valor antes de iniciar una base nueva.
ADMIN_PASSWORD=
# Activar solo cuando se publique detrás de un proxy con HTTPS.
SECURE_COOKIES=0
