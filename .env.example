# Exporta estas variables en tu terminal o usa docker --env-file.
# El archivo .env no se carga automáticamente.
HOST=127.0.0.1
PORT=8000
DB_PATH=data/cuenta.db
ADMIN_USER=admin
# Se usan solo al crear una base vacía. Vacío genera una clave y la muestra una vez.
ADMIN_PASSWORD=
DEMO=false
DEMO_PASSWORD=
# Activa cookies seguras al publicar detrás de un proxy HTTPS.
SECURE_COOKIES=false
CLOSING_ENABLED=true
